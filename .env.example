# Edge LLM (OpenAI-compatible endpoint — llama.cpp, Ollama, vLLM, MLX, ...)
EDGE_LLM_BASE_URL=http://localhost:18080/v1
EDGE_LLM_API_KEY=edge-unused
EDGE_LLM_MODEL=gemma4-4b

# Cloud LLM (litellm-compatible endpoint)
CLOUD_LLM_BASE_URL=http://127.0.0.1:4000/v1
CLOUD_LLM_API_KEY=replace-with-litellm-key
CLOUD_LLM_MODEL=claude-opus-4-7

# Router
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8080
ROUTER_LOG_LEVEL=INFO

# Privacy
MASK_MAP_TTL_SECONDS=3600

# Classifier
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
CLASSIFIER_FALLBACK=heavy
